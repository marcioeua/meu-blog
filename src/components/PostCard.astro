---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---
<article class="card">
  <span class="category">{category}</span>
  <h2><a href={`/blog/${post.id}/`}>{title}</a></h2>
  <p>{description}</p>
  <FormattedDate date={pubDate} />
</article>

<style>
  .card { border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; background: var(--surface); }
  .card h2 { font-size: 1.25rem; margin: .5rem 0; }
  .card h2 a { color: var(--text); text-decoration: none; }
  .card h2 a:hover { color: var(--accent); }
  .card p { color: var(--muted); margin: 0 0 .75rem; }
  .category { font-size: .75rem; font-weight: 700; text-transform: uppercase; color: var(--accent); letter-spacing: .05em; }
  time { font-size: .85rem; color: var(--muted); }
</style>
