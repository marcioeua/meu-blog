---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config';
---
<PageLayout title="Contato" description="Entre em contato conosco.">
  <p>Tem alguma dúvida, sugestão ou proposta de parceria? Fale com a gente:</p>
  <p><strong>E-mail:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  <p>Respondemos normalmente em até 2 dias úteis.</p>
</PageLayout>
