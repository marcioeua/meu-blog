---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdUnit from '../components/AdUnit.astro';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Móveis inteligentes</p>
    <h1>Sua casa mais <span>prática</span>, confortável e conectada</h1>
    <p class="lead">{SITE.description}</p>
    <a class="cta" href="/blog/">Ler os artigos</a>
  </section>

  <AdUnit position="header" />

  <section>
    <h2>Últimos artigos</h2>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <p class="more"><a href="/blog/">Ver todos os artigos →</a></p>
  </section>
</BaseLayout>

<style>
  .hero { margin-top: 2rem; padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem); background: var(--accent-soft); border-radius: 20px; text-align: center; }
  .eyebrow { margin: 0; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
  .hero h1 { font-size: clamp(1.9rem, 5.5vw, 3rem); line-height: 1.15; margin: .5rem auto 1rem; max-width: 18ch; letter-spacing: -.02em; }
  .hero h1 span { color: var(--accent); }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 52ch; margin: 0 auto 1.75rem; }
  .cta { display: inline-block; background: var(--accent); color: var(--on-accent); padding: .75rem 1.5rem; border-radius: 999px; font-weight: 700; text-decoration: none; }
  .cta:hover { background: var(--accent-strong); color: var(--on-accent); }
  h2 { margin-top: 3rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .more { text-align: center; margin-top: 2rem; }
</style>
